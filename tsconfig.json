{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./apps/web-legacy/*"
      ],
      "@core/*": [
        "./core/*"
      ]
    }
  },
  "include": [
    "backend/**/*.ts",
    "core/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "apps/mobile",
    "coverage"
  ],
  "extends": "expo/tsconfig.base"
}
