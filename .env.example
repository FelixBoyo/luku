# Backend + database tooling (copy to .env.local — never commit .env.local)
#
# The API reads .env then .env.local, with .env.local winning, and both files
# beating anything already exported in your shell. It reads them once at
# startup: editing a key while the server is running changes nothing until you
# stop and restart it. apps/mobile/.env is a different file and cannot affect
# server-side writes.
#
# To check what the running process is actually using:
#   npm run check:supabase                  # what is on disk
#   curl localhost:3001/health/supabase     # what the server booted with
# Matching fingerprints mean the restart took effect.
#
# If checkout fails with a row-level security error, do not guess at the key:
#   npm run diagnose:rls                    # reads Postgres directly for the answer
#   curl "localhost:3001/health/supabase?write=1"   # reproduces the checkout insert

# Supabase (required for Express BFF)
SUPABASE_URL=https://<project-ref>.supabase.co
# MUST be the secret / service_role key (sb_secret_... or a legacy JWT whose
# `role` claim is service_role). The publishable/anon key cannot bypass RLS, so
# order and payment writes fail mid-checkout after the buyer has been charged.
# The server refuses to boot if this is the wrong key class.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_ANON_KEY=<anon-key>
# Required for signInWithOtp / verifyOtp. OTP registration does not use a redirect URL.
SUPABASE_PROJECT_ID=<project-ref>

# Direct Postgres (npm run db:introspect, db:seed, db:migrate only)
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres

# Express
PORT=3001
ALLOWED_ORIGINS=exp://localhost:8081,http://localhost:8081
# Physical device: add your LAN IP, e.g. exp://192.168.1.10:8081,http://192.168.1.10:8081

# Auth
PASSWORD_RESET_REDIRECT_URL=luku://reset-password
# Must be allowlisted in Supabase → Authentication → URL Configuration.
# OTP registration does not use a redirect URL — see docs/ops/supabase-email-otp.md

# Payments / AI (optional for platform gate)
# PAYSTACK_SECRET_KEY=
# Paystack signs POST /webhooks/paystack with HMAC SHA512 of the raw body using
# the secret key. PAYSTACK_WEBHOOK_SECRET is optional and defaults to
# PAYSTACK_SECRET_KEY. Set it only if you need a dedicated override.
# PAYSTACK_WEBHOOK_SECRET=
# Local HTTPS: npm run tunnel:api (ngrok http 3001), then paste
# https://<subdomain>.ngrok-free.app/webhooks/paystack as the Test Webhook URL.
# Paystack Transfers (seller payouts on release). Leave unset/false until
# Transfers are enabled on the business account (not Starter). Confirm receipt
# still moves the order to released; payouts are deferred.
# PAYSTACK_TRANSFERS_ENABLED=true
# Shared secret for POST /v1/api/internal/reconcile (header x-reconcile-secret)
# RECONCILE_SECRET=

# AI Model Configuration (ADR-10: Gemini Cloud, Ollama Local, or Mock Offline)
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# AI_DEFAULT_MODEL=llama3.2
# GEMINI_API_KEY=

# Escrow policy (ADR-11). Uncomment to override; omit to use these defaults.
# ESCROW_SHIP_BY_DAYS=3
# ESCROW_AUTO_RELEASE_DAYS=7
# ESCROW_COMMISSION_RATE=0.1
# VAT is charged to the buyer and escrowed, but is never part of the payout
# base (D12). Overriding it here diverges from the mobile app's displayed
# estimate, which reads the shared VAT_RATE constant.
# ESCROW_VAT_RATE=0.16
# ESCROW_BUYER_REMINDER_DAYS=3,6
# ESCROW_SELLER_REMINDER_DAYS=2
