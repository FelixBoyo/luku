# Set false to use Express BFF (auth, profile, connections, products)
EXPO_PUBLIC_USE_MOCK_DATA=false
# Simulator/emulator: http://localhost:3001
# Physical device: http://<YOUR-LAN-IP>:3001
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001

# Native Google sign-in client IDs (from Google Cloud console).
# iOS client ID is used on device; web client ID is the Supabase "Authorized Client ID".
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
